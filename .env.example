# agent-gw 网关（语音合成 TTS，必填——否则无法生成配音）
AGENT_GW_API_KEY=
AGENT_GW_BASE_URL=https://agent-gw.kimi.com/coding

# Moonshot 开放平台（讲解稿生成，可选——不配置时使用内置模板降级）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn
MOONSHOT_MODEL=kimi-k2.7-code-highspeed

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL 连接串（会员注册登录功能必填）
